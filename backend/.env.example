# Server Port
PORT=5000

# MongoDB Connection String
MONGO_URL=mongodb://127.0.0.1:27017/AI-Grievance-DB

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Bhashini API configuration (Optional - fallback simulation handles missing keys)
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Clerk Authentication Configuration
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
ADMIN_SECRET_KEY=your_admin_portal_secret_key

# Twilio SMS and WhatsApp Gateway configuration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Email Notification configuration (Optional Gmail SMTP)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password_here
